"use strict";
document.getElementById("thumbs").addEventListener("click", function(e) {
    e.preventDefault();
    var target = event.target;
    if (target.tagName === "IMG") target = target.closest("a");
    if (target.tagName === "A") return;
    var largeImg = document.getElementById("largeImg");
    var newSrc = target.getAttribute("href");
    var newAlt = target.getAttribute("title");
    largeImg.src = newSrc;
    largeImg.alt = newAlt;
});

